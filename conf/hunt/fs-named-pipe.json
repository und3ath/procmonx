{
  "_desc": "Named-pipe create/connect/IO by a privileged process: impersonation / spoofing targets. Named-pipe I/O is the IPC event class, not FileSystem. Restricted to High/System/Protected integrity callers (LPE-relevant).",
  "filters": [
    { "column": "Class", "relation": "isNot", "value": "IPC", "action": "exclude" },
    { "column": "Path", "relation": "contains", "value": "\\Device\\NamedPipe", "action": "include" },
    { "column": "Integrity", "relation": "is", "value": "Medium", "action": "exclude" },
    { "column": "Integrity", "relation": "is", "value": "Medium+", "action": "exclude" },
    { "column": "Integrity", "relation": "is", "value": "Low", "action": "exclude" },
    { "column": "Integrity", "relation": "is", "value": "Untrusted", "action": "exclude" }
  ]
}
